---
import merge from "lodash.merge";
import { SEO } from "astro-seo";
import type { Props as SEOProps, TwitterCardType } from "astro-seo";

import { SITE, METADATA, I18N } from "astrowind:config";
import type { MetaData } from "~/types";
import { getCanonical } from "~/utils/permalinks";

import { adaptOpenGraphImages } from "~/utils/images";
import type { OpenGraph } from "~/utils/images";

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

interface FlatSeoProps {
  title: string;
  titleTemplate: string;
  canonical: string;
  noindex?: boolean;
  nofollow?: boolean;
  description?: string;
  openGraph: OpenGraph;
  twitter: { handle?: string; site?: string; cardType?: string };
}

const seoProps = merge(
  {
    title: "",
    titleTemplate: "%s",
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: I18N?.language || "en",
      type: "website",
      article: {
        authors: [SITE?.author],
      },
    },
    twitter: {
      cardType: openGraph?.images?.length ? "summary_large_image" : "summary",
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex:
      typeof METADATA?.robots?.index !== "undefined"
        ? !METADATA.robots.index
        : undefined,
    nofollow:
      typeof METADATA?.robots?.follow !== "undefined"
        ? !METADATA.robots.follow
        : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? "%s" : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== "undefined" ? !robots.index : undefined,
    nofollow:
      typeof robots?.follow !== "undefined" ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
) as FlatSeoProps;

const adaptedOpenGraph = await adaptOpenGraphImages(
  seoProps.openGraph,
  Astro.site
);

const firstImage = adaptedOpenGraph.images?.[0];
const firstImageUrl =
  typeof firstImage?.url === "string" ? firstImage.url : undefined;

const astroSeoProps: SEOProps = {
  title: seoProps.title,
  titleTemplate: seoProps.titleTemplate,
  canonical: seoProps.canonical,
  noindex: seoProps.noindex,
  nofollow: seoProps.nofollow,
  description: seoProps.description,
  twitter: {
    card: seoProps.twitter.cardType as TwitterCardType,
    site: seoProps.twitter.site,
    creator: seoProps.twitter.handle,
  },
};

if (
  adaptedOpenGraph.type &&
  (seoProps.title || adaptedOpenGraph.title) &&
  firstImageUrl
) {
  astroSeoProps.openGraph = {
    basic: {
      title: adaptedOpenGraph.title ?? seoProps.title,
      type: adaptedOpenGraph.type,
      image: firstImageUrl,
      url: adaptedOpenGraph.url,
    },
    optional: {
      description: adaptedOpenGraph.description ?? seoProps.description,
      locale: adaptedOpenGraph.locale,
      siteName: adaptedOpenGraph.site_name,
    },
    image: {
      url: firstImageUrl,
      width: firstImage.width,
      height: firstImage.height,
      alt: firstImage.alt,
    },
    article: adaptedOpenGraph.article
      ? {
          publishedTime: adaptedOpenGraph.article.publishedTime,
          modifiedTime: adaptedOpenGraph.article.modifiedTime,
          expirationTime: adaptedOpenGraph.article.expirationTime,
          authors: adaptedOpenGraph.article.authors
            ? [...adaptedOpenGraph.article.authors]
            : undefined,
          section: adaptedOpenGraph.article.section,
          tags: adaptedOpenGraph.article.tags
            ? [...adaptedOpenGraph.article.tags]
            : undefined,
        }
      : undefined,
  };
}
---

<SEO {...astroSeoProps} />
