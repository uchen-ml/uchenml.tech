<style is:inline>
  ::selection {
    background-color: lavender;
  }

  .dark ::selection {
    background-color: black;
    color: snow;
  }

  html,
  body {
    overflow-x: hidden;
    max-width: 100vw;
  }

  .prose {
    overflow-wrap: break-word;
  }

  @media (max-width: 640px) {
    .prose {
      font-size: 0.875rem;
      line-height: 1.5;
    }
  }

  .prose code {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .prose pre code {
    white-space: pre;
    word-wrap: normal;
  }

  .prose code:not(pre code) {
    word-break: break-all;
  }

  .prose pre::-webkit-scrollbar {
    height: 8px;
  }

  .prose pre::-webkit-scrollbar-track {
    background: rgba(156, 163, 175, 0.2);
    border-radius: 4px;
  }

  .prose pre::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.5);
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .prose pre::-webkit-scrollbar-thumb:hover {
    background: rgba(156, 163, 175, 0.7);
  }

  .dark .prose pre::-webkit-scrollbar-track {
    background: rgba(75, 85, 99, 0.3);
  }

  .dark .prose pre::-webkit-scrollbar-thumb {
    background: rgba(107, 114, 128, 0.6);
  }

  .dark .prose pre::-webkit-scrollbar-thumb:hover {
    background: rgba(107, 114, 128, 0.8);
  }

  .prose pre {
    scrollbar-width: thin;
    scrollbar-color: rgba(156, 163, 175, 0.5) rgba(156, 163, 175, 0.2);
  }

  .dark .prose pre {
    scrollbar-color: rgba(107, 114, 128, 0.6) rgba(75, 85, 99, 0.3);
  }
</style>
